[Unit]
Description=Relay development worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/services/relay-development-worker/current
EnvironmentFile=%h/.config/relay-worker/development.env
Environment=RELAY_ENV=development
ExecStart=/usr/bin/npm run start --workspace @relay/worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
