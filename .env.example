# Written by `convex dev` after the local deployment is configured.
RELAY_ENV=development
CONVEX_DEPLOYMENT=
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211

# Expose the Convex client URL only when the web application starts using it.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Server-only development identity boundary for membership-backed projects.
# `npm run dev:loop` configures these local values automatically.
PROJECTS_CONVEX_URL=http://127.0.0.1:3210
PROJECTS_SERVER_TOKEN=
NARRATION_ENABLED=false
NARRATION_CONVEX_URL=http://127.0.0.1:3210
NARRATION_WORKER_TOKEN=
# NARRATION_OPENAI_API_KEY=
# NARRATION_OPENAI_MODEL=whisper-1
# NARRATION_OPENAI_BASE_URL=https://api.openai.com/v1
# Project draft rendering reuses the narration worker's durable Convex
# connection and credential.
RELAY_COMPONENT_PREVIEW_ORIGIN=http://127.0.0.1:3212
RELAY_DEV_USER_SUBJECT=relay-dev-user
RELAY_DEV_USER_NAME=Relay creator
RELAY_DEV_CHANNEL_SLUG=relay-studio
RELAY_DEV_CHANNEL_NAME=Relay Studio

# Worker settings contain no provider credentials in the foundation scaffold.
WORKER_PORT=3212
# Required when the worker is reachable outside loopback. Configure the same
# server-only value in the web deployment and worker environment.
# Required whenever worker-backed features are enabled. Production alpha
# intentionally omits this value because it has no worker.
RELAY_WORKER_URL=http://127.0.0.1:3212
RELAY_WORKER_AUTH_TOKEN=
# `npm run dev` overrides both values with the local worker on port 3213 and a
# fixed development-only token. Override only the port with:
# RELAY_LOCAL_WORKER_PORT=3213
# RELAY_LOCAL_WORKER_AUTH_TOKEN=relay-local-worker

# Optional MED-133 component-build loop. Normal development keeps this off.
# Set true only with a matching Convex URL and server-side worker token.
# Keep COMPONENT_BUILD_WORKER_TOKEN only in Convex and the worker environment.
COMPONENT_BUILD_ENABLED=false
COMPONENT_BUILD_CONVEX_URL=
COMPONENT_BUILD_WORKER_TOKEN=
COMPONENT_BUILD_WORKSPACE_ROOT=.relay/component-build-workspaces

# Optional MED-128 authoring loop. When enabled, authoring always uses the
# configured Pi provider/model and server-only credential.
AUTHORING_ENABLED=false
AUTHORING_CONVEX_URL=http://127.0.0.1:3210
AUTHORING_WORKER_TOKEN=
AUTHORING_WORKSPACE_ROOT=.relay/component-authoring-workspaces
AUTHORING_PI_SESSION_ROOT=.relay/component-authoring-sessions
AUTHORING_REAL_PI_ENABLED=true
AUTHORING_PI_MODEL=openai-codex/gpt-5.6-sol
# Server-only JSON credential consumed into memory and never copied into Pi
# sessions, context, logs, or workspaces. Supply either an api_key credential
# or the provider's complete OAuth credential. Never commit a value here.
AUTHORING_PI_CREDENTIAL_JSON=

# MED-157 script revision providers are separate from Pi authoring. Credentials
# stay server-only. Configure either Kimi Code's OpenAI-compatible endpoint or
# OpenAI's Responses API; only configured models appear in the editor picker.
SCRIPT_REVISION_PROVIDER=kimi-code
SCRIPT_REVISION_MODEL=k3-256k
SCRIPT_REVISION_KIMI_MODELS=k3-256k,kimi-for-coding,kimi-for-coding-highspeed,k3
SCRIPT_REVISION_KIMI_BASE_URL=https://api.kimi.com/coding/v1
SCRIPT_REVISION_KIMI_API_KEY_FILE=
KIMI_API_KEY=
SCRIPT_REVISION_OPENAI_MODELS=gpt-5.6
SCRIPT_REVISION_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Explicit paid smoke only. Never place provider credentials here.
AUTHORING_PI_SMOKE_CONFIRM=
AUTHORING_PI_SMOKE_MAX_WALL_MS=60000
AUTHORING_PI_SMOKE_MAX_TOKENS=4000
AUTHORING_PI_SMOKE_MAX_COST_USD=0.25
